+// Contents of the floating command bar: a text field plus a list of results
+// merged from the omnibox autocomplete engine, open tabs and browser
+// commands. Owned by its bubble widget.
+class CommandBarView : public views::View,
+                       public views::TextfieldController,
+                       public AutocompleteController::Observer {
+  METADATA_HEADER(CommandBarView, views::View)
+
+ public:
