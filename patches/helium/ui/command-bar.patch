+// Matches the omnibox would show that don't make sense as a plain row.
+bool ShouldSkipMatch(const AutocompleteMatch& match) {
+  using Type = omnibox::AutocompleteMatchType;
+  switch (match.type) {
+    case Type::kNullResultMessage:
+    case Type::kTileSuggestion:
+    case Type::kTileNavsuggest:
+    case Type::kTileMostVisitedSite:
+    case Type::kTileRepeatableQuery:
+    case Type::kHistoryEmbeddingsAnswer:
+    case Type::kHistoryCluster:
+    case Type::kPedal:
+    case Type::kClipboardImage:
+    case Type::kTabGroup:
+      return true;
+    default:
+      return match.destination_url.is_empty() ||
+             !match.destination_url.is_valid();
+  }
+}
+
+bool IsNewTabPageUrl(const GURL& url) {
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         (url.host() == chrome::kChromeUINewTabHost ||
+          url.host() == chrome::kChromeUINewTabPageHost);
+}
+
+std::u16string DisplayHost(const GURL& url) {
+  std::string host = url.host();
+  if (host.starts_with("www.")) {
+    host = host.substr(4);
+  }
+  return base::UTF8ToUTF16(host.empty() ? url.spec() : host);
+}
+
+std::u16string GetShortcutText(BrowserWindowInterface* browser,
+                               int command_id) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  ui::Accelerator accelerator;
+  if (!browser_view ||
+      !browser_view->GetAccelerator(command_id, &accelerator)) {
+    return std::u16string();
+  }
+  return accelerator.GetShortcutText();
+}
+
+}  // namespace
+
+bool ToggleCommandBar(BrowserWindowInterface* browser) {
+  if (!base::FeatureList::IsEnabled(features::kHeliumCommandBar) || !browser ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      browser->IsDeleteScheduled() || !browser->GetActiveTabInterface()) {
+    return false;
+  }
+
+  if (CommandBarView* open_bar = CommandBarView::GetForBrowser(browser)) {
+    open_bar->CloseBar();
+    return true;
+  }
+
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget() ||
+      !browser_view->GetWidget()->IsVisible() ||
+      browser_view->GetWidget()->IsMinimized()) {
+    return false;
+  }
+
+  CommandBarView::Show(browser, browser_view);
+  return true;
+}
+
+CommandBarView::Item::Item() = default;
+CommandBarView::Item::Item(Item&&) = default;
+CommandBarView::Item& CommandBarView::Item::operator=(Item&&) = default;
+CommandBarView::Item::~Item() = default;
+
+// static
+CommandBarView* CommandBarView::GetForBrowser(
+    const BrowserWindowInterface* browser) {
+  auto& bars = GetOpenBars();
+  auto it = bars.find(browser);
+  return it == bars.end() ? nullptr : it->second;
+}
+
+// static
+void CommandBarView::Show(BrowserWindowInterface* browser,
+                          BrowserView* browser_view) {
+  tabs::TabInterface* active_tab = browser->GetActiveTabInterface();
+  CHECK(active_tab);
+
+  views::View* contents_area = browser_view->contents_container();
+  const gfx::Rect area = contents_area && contents_area->GetVisible()
+                             ? contents_area->GetBoundsInScreen()
+                             : browser_view->GetBoundsInScreen();
+  const int width =
+      std::clamp(area.width() - 2 * kMinSideMargin, kMinWidth, kMaxWidth);
+  // Sit in the upper part of the page, like Arc and Spotlight, and grow
+  // downwards as results come in.
+  const int top = area.y() + std::clamp(area.height() / 6, 24, 140);
+
+  auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+      static_cast<views::View*>(nullptr), views::BubbleBorder::NONE,
+      views::BubbleBorder::DIALOG_SHADOW, /*autosize=*/true);
+  delegate->SetOwnedByWidget(views::WidgetDelegate::OwnedByWidgetPassKey());
+  delegate->set_parent_window(browser_view->GetWidget()->GetNativeView());
+  delegate->SetAnchorRect(gfx::Rect(area.CenterPoint().x(), top, 0, 0));
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->SetShowTitle(false);
+  delegate->SetShowCloseButton(false);
+  delegate->SetAccessibleTitle(
+      l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_ACCESSIBLE_NAME));
+  delegate->set_internal_name("HeliumCommandBar");
+  delegate->set_margins(gfx::Insets());
+  delegate->set_fixed_width(width);
+  delegate->set_corner_radius(kCornerRadius);
+  delegate->set_close_on_deactivate(true);
+  delegate->SetBackgroundColor(kColorOmniboxResultsBackground);
+
+  auto view = std::make_unique<CommandBarView>(browser, active_tab);
+  CommandBarView* command_bar = view.get();
+  delegate->SetInitiallyFocusedView(command_bar->textfield());
+  delegate->SetContentsView(std::move(view));
+
+  views::Widget* widget = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(delegate),
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  widget->Show();
+  command_bar->Start();
+}
+
+CommandBarView::CommandBarView(BrowserWindowInterface* browser,
+                               tabs::TabInterface* active_tab)
+    : browser_(browser) {
+  GetOpenBars()[browser_] = this;
+
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  // Header: search icon + text field.
+  auto* header = AddChildView(std::make_unique<views::BoxLayoutView>());
+  header->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  header->SetInsideBorderInsets(gfx::Insets::VH(0, 18));
+  header->SetBetweenChildSpacing(12);
+  header->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  header->SetMinimumCrossAxisSize(kHeaderHeight);
+
+  auto* search_icon = header->AddChildView(
+      std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+          vector_icons::kSearchIcon, kColorOmniboxResultsIcon,
+          kHeaderIconSize)));
+  search_icon->SetCanProcessEventsWithinSubtree(false);
+
+  textfield_ = header->AddChildView(std::make_unique<views::Textfield>());
+  textfield_->SetController(this);
+  textfield_->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_PLACEHOLDER));
+  textfield_->SetFontList(
+      views::TypographyProvider::Get()
+          .GetFont(views::style::CONTEXT_TEXTFIELD, views::style::STYLE_PRIMARY)
+          .DeriveWithSizeDelta(kTextfieldFontSizeDelta));
+  textfield_->SetBorder(views::CreateEmptyBorder(0));
+  textfield_->SetBackgroundEnabled(false);
+  textfield_->RemoveHoverEffect();
+  textfield_->SetTextColorId(kColorOmniboxText);
+  textfield_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_ACCESSIBLE_NAME));
+  views::FocusRing::Remove(textfield_);
+  header->SetFlexForView(textfield_, 1);
+
+  separator_ = AddChildView(std::make_unique<views::Separator>());
+  separator_->SetVisible(false);
+
+  auto* results = AddChildView(std::make_unique<views::BoxLayoutView>());
+  results->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  results->SetInsideBorderInsets(gfx::Insets::VH(6, 6));
+  results->SetBetweenChildSpacing(2);
+  results->SetVisible(false);
+  results_ = results;
+
+  // The autocomplete engine. A fresh controller per command bar keeps its
+  // state (and the tab it looks at) scoped to this session.
+  auto client = std::make_unique<CommandBarOmniboxClient>(
+      browser_, active_tab->GetContents());
+  client_ = client.get();
+  omnibox_controller_ = std::make_unique<OmniboxController>(std::move(client));
+  autocomplete_observation_.Observe(
+      omnibox_controller_->autocomplete_controller());
+
+  active_tab_subscription_ =
+      browser_->RegisterActiveTabDidChange(base::BindRepeating(
+          &CommandBarView::OnActiveTabChanged, base::Unretained(this)));
+  tab_detach_subscription_ = active_tab->RegisterWillDetach(base::BindRepeating(
+      &CommandBarView::OnTabWillDetach, base::Unretained(this)));
+  browser_close_subscription_ =
+      browser_->RegisterBrowserDidClose(base::BindRepeating(
+          &CommandBarView::OnBrowserDidClose, base::Unretained(this)));
+}
+
+CommandBarView::~CommandBarView() {
+  auto& bars = GetOpenBars();
+  auto it = bars.find(browser_);
+  if (it != bars.end() && it->second == this) {
+    bars.erase(it);
+  }
+  autocomplete_observation_.Reset();
+}
+
+void CommandBarView::Start() {
+  if (!omnibox_controller_) {
+    return;
+  }
+  omnibox_controller_->edit_model()->OnSetFocus(/*control_down=*/false);
+  QueryAutocomplete(/*on_focus=*/true);
+  RebuildItems();
+}
+
+void CommandBarView::CloseBar() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+
+  // Unregister right away so a repeated Cmd/Ctrl+T opens a new bar instead of
+  // trying to close this one again.
+  auto& bars = GetOpenBars();
+  auto it = bars.find(browser_);
+  if (it != bars.end() && it->second == this) {
+    bars.erase(it);
+  }
+
+  ShutdownOmnibox();
+  active_tab_subscription_ = {};
+  tab_detach_subscription_ = {};
+
+  if (views::Widget* widget = GetWidget()) {
+    widget->Close();
+  }
+}
+
+void CommandBarView::ShutdownOmnibox() {
+  autocomplete_observation_.Reset();
+  if (!omnibox_controller_) {
+    return;
+  }
+  if (activation_depth_ > 0) {
+    // We're inside OmniboxEditModel::OpenSelection(); the controller is
+    // destroyed with this view once the bubble finishes closing.
+    return;
+  }
+  omnibox_controller_->StopAutocomplete(/*clear_result=*/true);
+  omnibox_controller_->edit_model()->OnWillKillFocus();
+  omnibox_controller_->edit_model()->OnKillFocus();
+  client_ = nullptr;
+  omnibox_controller_.reset();
+}
+
+void CommandBarView::ContentsChanged(views::Textfield* sender,
+                                     const std::u16string& new_contents) {
+  user_moved_selection_ = false;
+  QueryAutocomplete(/*on_focus=*/false);
+  RebuildItems();
+}
+
+bool CommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                    const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed ||
+      textfield_->IsIMEComposing()) {
+    return false;
+  }
+
+  const bool control_only =
+      (key_event.flags() & (ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                            ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN)) ==
+      ui::EF_CONTROL_DOWN;
+
+  switch (key_event.key_code()) {
+    case ui::VKEY_UP:
+      MoveSelection(-1);
+      return true;
+    case ui::VKEY_DOWN:
+      MoveSelection(1);
+      return true;
+    case ui::VKEY_TAB:
+      MoveSelection(key_event.IsShiftDown() ? -1 : 1);
+      return true;
+    case ui::VKEY_P:
+      if (control_only) {
+        MoveSelection(-1);
+        return true;
+      }
+      return false;
+    case ui::VKEY_N:
+      if (control_only) {
+        MoveSelection(1);
+        return true;
+      }
+      return false;
+    case ui::VKEY_RETURN:
+      ActivateItem(selected_, key_event.flags());
+      return true;
+    case ui::VKEY_ESCAPE:
+      CloseBar();
+      return true;
+    default:
+      return false;
+  }
+}
+
+void CommandBarView::OnResultChanged(AutocompleteController* controller,
+                                     bool default_match_changed) {
+  RebuildItems();
+}
+
+void CommandBarView::QueryAutocomplete(bool on_focus) {
+  if (closing_ || !omnibox_controller_) {
+    return;
+  }
+
+  const std::u16string text(textfield_->GetText());
+  OmniboxEditModel* model = omnibox_controller_->edit_model();
+  AutocompleteController* autocomplete =
+      omnibox_controller_->autocomplete_controller();
+
+  if (!on_focus) {
+    // Mirrors SearchboxHandler: the edit model's state has to agree with the
+    // input or OpenSelection() trips over stale keyword/user-text state.
+    model->SetUserText(text);
+    if (text.empty()) {
+      // Clearing the field behaves like focusing an empty omnibox again.
+      // Drop the query for the old text first so its results don't linger.
+      omnibox_controller_->StopAutocomplete(/*clear_result=*/true);
+      on_focus = true;
+    }
+  } else if (!autocomplete->done()) {
+    return;
+  }
+  model->SetKeywordInfo(KeywordState::kNone, u"", u"",
+                        metrics::OmniboxEventProto::INVALID);
+
+  AutocompleteInput input(
+      text, text.size(), client_->GetPageClassification(/*is_prefetch=*/false),
+      ChromeAutocompleteSchemeClassifier(browser_->GetProfile()));
+  input.set_current_url(GURL(chrome::kChromeUINewTabURL));
+  input.set_focus_type(on_focus
+                           ? metrics::OmniboxFocusType::INTERACTION_FOCUS
+                           : metrics::OmniboxFocusType::INTERACTION_DEFAULT);
+  // The text field shows exactly what was typed; the top row is the default
+  // match instead of an inline completion.
+  input.set_prevent_inline_autocomplete(true);
+
+  model->SetAutocompleteInput(input);
+  omnibox_controller_->StartAutocomplete(input);
+}
+
+void CommandBarView::RebuildItems() {
+  // Rebuilding destroys the rows, one of which may be the button whose press
+  // is currently opening a match.
+  if (closing_ || activation_depth_ > 0) {
+    return;
+  }
+
+  const std::string previous_key =
+      selected_ < items_.size() ? items_[selected_].key : std::string();
+
+  std::u16string query;
+  base::TrimWhitespace(base::i18n::ToLower(textfield_->GetText()),
+                       base::TRIM_ALL, &query);
+
+  std::vector<Item> autocomplete_items;
+  if (omnibox_controller_) {
+    const AutocompleteResult& result =
+        omnibox_controller_->autocomplete_controller()->result();
+    for (size_t line = 0; line < result.size() &&
+                          autocomplete_items.size() < kMaxAutocompleteResults;
+         ++line) {
+      const AutocompleteMatch& match = result.match_at(line);
+      if (ShouldSkipMatch(match) ||
+          omnibox_controller_->IsSuggestionHidden(match)) {
+        continue;
+      }
+      autocomplete_items.push_back(MakeAutocompleteItem(match, line));
+    }
+  }
+
+  const std::vector<command_bar::TabMatch> tabs = command_bar::MatchTabs(
+      browser_, query, query.empty() ? kMaxRecentTabResults : kMaxTabResults);
+  const std::vector<command_bar::CommandMatch> commands =
+      command_bar::MatchCommands(browser_, query, kMaxCommandResults);
+  const bool commands_first = !commands.empty() && commands.front().strong;
+
+  std::vector<Item> items;
+  auto append_commands = [&] {
+    for (const auto& command : commands) {
+      items.push_back(MakeCommandItem(command.command->command_id,
+                                      command.command->label_id));
+    }
+  };
+
+  // Order: [strong commands] default web result, open tabs, [commands],
+  // remaining web results.
+  if (commands_first) {
+    append_commands();
+  }
+  if (!autocomplete_items.empty()) {
+    items.push_back(std::move(autocomplete_items.front()));
+  }
+  for (const auto& tab : tabs) {
+    if (tab.tab) {
+      items.push_back(MakeTabItem(tab.tab.get()));
+    }
+  }
+  if (!commands_first) {
+    append_commands();
+  }
+  for (size_t i = 1; i < autocomplete_items.size(); ++i) {
+    items.push_back(std::move(autocomplete_items[i]));
+  }
+
+  items_ = std::move(items);
+
+  selected_ = 0;
+  if (user_moved_selection_ && !previous_key.empty()) {
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (items_[i].key == previous_key) {
+        selected_ = i;
+        break;
+      }
+    }
+  }
+
+  UpdateRows();
+}
+
+CommandBarView::Item CommandBarView::MakeAutocompleteItem(
+    const AutocompleteMatch& match,
+    size_t line) {
+  Item item;
+  item.kind = Item::Kind::kAutocomplete;
+  item.autocomplete_line = line;
+  item.key = "ac:" + match.destination_url.spec();
+
+  const ui::ImageModel vector_icon =
+      ui::ImageModel::FromVectorIcon(match.GetVectorIcon(/*is_bookmark=*/false),
+                                     kColorOmniboxResultsIcon, kResultIconSize);
+
+  if (AutocompleteMatch::IsSearchType(match.type)) {
+    item.title = match.contents;
+    if (match.type == omnibox::AutocompleteMatchType::kSearchOtherEngine) {
+      item.subtitle = match.description;
+    }
+    item.hint = l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_HINT_SEARCH);
+    item.icon = vector_icon;
+    return item;
+  }
+
+  if (match.description.empty()) {
+    item.title = match.contents;
+  } else {
+    item.title = match.description;
+    item.subtitle = match.contents;
+  }
+  item.hint =
+      l10n_util::GetStringUTF16(match.has_tab_match.value_or(false)
+                                    ? IDS_HELIUM_COMMAND_BAR_HINT_SWITCH_TO_TAB
+                                    : IDS_HELIUM_COMMAND_BAR_HINT_OPEN);
+
+  item.icon = vector_icon;
+  if (client_) {
+    const gfx::Image favicon = client_->GetFaviconForPageUrl(
+        match.destination_url,
+        base::BindOnce(&CommandBarView::OnFaviconFetched,
+                       weak_factory_.GetWeakPtr(), match.destination_url));
+    if (!favicon.IsEmpty()) {
+      item.icon = ui::ImageModel::FromImage(favicon);
+    } else {
+      item.favicon_page_url = match.destination_url;
+    }
+  }
+  return item;
+}
+
+CommandBarView::Item CommandBarView::MakeTabItem(tabs::TabInterface* tab) {
+  Item item;
+  item.kind = Item::Kind::kTab;
+  item.tab = tab->GetWeakPtr();
+  item.key = "tab:" + base::NumberToString(reinterpret_cast<uintptr_t>(tab));
+
+  const GURL url = tab->GetURL();
+  item.title = tab->GetTitle();
+  if (item.title.empty()) {
+    item.title = base::UTF8ToUTF16(url.spec());
+  } else {
+    item.subtitle = DisplayHost(url);
+  }
+  item.hint =
+      l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_HINT_SWITCH_TO_TAB);
+
+  gfx::Image favicon;
+  if (content::WebContents* contents = tab->GetContents()) {
+    if (auto* driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents)) {
+      favicon = driver->GetFavicon();
+    }
+  }
+  item.icon =
+      favicon.IsEmpty()
+          ? favicon::GetDefaultFaviconModel(kColorOmniboxResultsBackground)
+          : ui::ImageModel::FromImage(favicon);
+  return item;
+}
+
+CommandBarView::Item CommandBarView::MakeCommandItem(int command_id,
+                                                     int label_id) {
+  Item item;
+  item.kind = Item::Kind::kCommand;
+  item.command_id = command_id;
+  item.key = "cmd:" + base::NumberToString(command_id);
+  item.title = l10n_util::GetStringUTF16(label_id);
+  item.subtitle = GetShortcutText(browser_, command_id);
+  item.hint =
+      l10n_util::GetStringUTF16(IDS_HELIUM_COMMAND_BAR_HINT_RUN_COMMAND);
+  item.icon = ui::ImageModel::FromVectorIcon(
+      vector_icons::kKeyboardIcon, kColorOmniboxResultsIcon, kResultIconSize);
+  return item;
+}
+
+void CommandBarView::UpdateRows() {
+  rows_.clear();
+  results_->RemoveAllChildViews();
+
+  for (size_t i = 0; i < items_.size(); ++i) {
+    const Item& item = items_[i];
+    auto* row = results_->AddChildView(std::make_unique<CommandBarRowView>(
+        base::BindRepeating(&CommandBarView::OnRowPressed,
+                            base::Unretained(this), i),
+        base::BindRepeating(&CommandBarView::OnRowHovered,
+                            base::Unretained(this), i)));
+    row->SetContent(item.icon, item.title, item.subtitle, item.hint);
+    row->SetSelected(i == selected_);
+    rows_.push_back(row);
+  }
+
+  const bool has_results = !items_.empty();
+  results_->SetVisible(has_results);
+  separator_->SetVisible(has_results);
+  PreferredSizeChanged();
+}
+
+void CommandBarView::SetSelectedIndex(size_t index) {
+  if (index >= rows_.size() || index == selected_) {
+    return;
+  }
+  if (selected_ < rows_.size()) {
+    rows_[selected_]->SetSelected(false);
+  }
+  selected_ = index;
+  rows_[selected_]->SetSelected(true);
+}
+
+void CommandBarView::MoveSelection(int delta) {
+  if (rows_.empty()) {
+    return;
+  }
+  user_moved_selection_ = true;
+  const int count = static_cast<int>(rows_.size());
+  const int next = (static_cast<int>(selected_) + delta + count) % count;
+  SetSelectedIndex(static_cast<size_t>(next));
+}
+
+void CommandBarView::ActivateItem(size_t index, int event_flags) {
+  if (closing_) {
+    return;
+  }
+
+  if (index >= items_.size()) {
+    if (textfield_->GetText().empty()) {
+      OpenBlankNewTab();
+    } else {
+      // Nothing to pick yet (results still loading): open what was typed.
+      ActivateAutocompleteMatch(OmniboxPopupSelection::kNoMatch, event_flags);
+    }
+    return;
+  }
+
+  const Item& item = items_[index];
+  switch (item.kind) {
+    case Item::Kind::kAutocomplete:
+      ActivateAutocompleteMatch(item.autocomplete_line, event_flags);
+      return;
+
+    case Item::Kind::kTab: {
+      base::WeakPtr<tabs::TabInterface> tab = item.tab;
+      CloseBar();
+      if (!tab) {
+        return;
+      }
+      BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+      if (!window) {
+        return;
+      }
+      TabStripModel* model = window->GetTabStripModel();
+      const int tab_index = model->GetIndexOfTab(tab.get());
+      if (tab_index != TabStripModel::kNoTab) {
+        model->ActivateTabAt(
+            tab_index, TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+      }
+      window->GetWindow()->Activate();
+      return;
+    }
+
+    case Item::Kind::kCommand: {
+      const int command_id = item.command_id;
+      base::WeakPtr<BrowserWindowInterface> browser = browser_->GetWeakPtr();
+      CloseBar();
+      // Run after the bubble is gone so commands that open dialogs or move
+      // focus (find bar, devtools, ...) act on the browser window.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](base::WeakPtr<BrowserWindowInterface> browser,
+                            int command_id) {
+                           if (browser) {
+                             chrome::ExecuteCommand(browser.get(), command_id);
+                           }
+                         },
+                         browser, command_id));
+      return;
+    }
+  }
+}
+
+void CommandBarView::ActivateAutocompleteMatch(size_t line, int event_flags) {
+  if (!omnibox_controller_) {
+    return;
+  }
+
+  const AutocompleteResult& result =
+      omnibox_controller_->autocomplete_controller()->result();
+  WindowOpenDisposition disposition;
+  if (line == OmniboxPopupSelection::kNoMatch || line >= result.size()) {
+    line = OmniboxPopupSelection::kNoMatch;
+    disposition = IsActiveTabReusable()
+                      ? WindowOpenDisposition::CURRENT_TAB
+                      : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  } else {
+    disposition = DispositionForMatch(result.match_at(line), event_flags);
+  }
+
+  {
+    base::AutoReset<int> in_activation(&activation_depth_,
+                                       activation_depth_ + 1);
+    omnibox_controller_->edit_model()->OpenSelection(
+        OmniboxPopupSelection(line), base::TimeTicks::Now(), disposition,
+        /*via_keyboard=*/true);
+  }
+  CloseBar();
+}
+
+void CommandBarView::OpenBlankNewTab() {
+  base::WeakPtr<BrowserWindowInterface> browser = browser_->GetWeakPtr();
+  CloseBar();
+  if (browser) {
+    chrome::NewTab(browser.get(), NewTabTypes::kNewTabCommand);
+  }
+}
+
+WindowOpenDisposition CommandBarView::DispositionForMatch(
+    const AutocompleteMatch& match,
+    int event_flags) const {
+  if (event_flags & ui::EF_SHIFT_DOWN) {
+    return WindowOpenDisposition::NEW_WINDOW;
+  }
+  if (event_flags & ui::EF_PLATFORM_ACCELERATOR) {
+    return WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  }
+  if (event_flags & ui::EF_ALT_DOWN) {
+    // Option/Alt+Enter replaces the current tab, like the address bar does.
+    return WindowOpenDisposition::CURRENT_TAB;
+  }
+  if (match.has_tab_match.value_or(false)) {
+    return WindowOpenDisposition::SWITCH_TO_TAB;
+  }
+  // Don't stack another tab on top of an untouched new tab page.
+  return IsActiveTabReusable() ? WindowOpenDisposition::CURRENT_TAB
+                               : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+}
+
+bool CommandBarView::IsActiveTabReusable() const {
+  content::WebContents* contents = client_ ? client_->web_contents() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  return (IsNewTabPageUrl(contents->GetLastCommittedURL()) ||
+          IsNewTabPageUrl(contents->GetVisibleURL())) &&
+         !contents->GetController().CanGoBack();
+}
+
+void CommandBarView::OnRowPressed(size_t index, const ui::Event& event) {
+  ActivateItem(index, event.flags());
+}
+
+void CommandBarView::OnRowHovered(size_t index) {
+  if (index == selected_) {
+    return;
+  }
+  user_moved_selection_ = true;
+  SetSelectedIndex(index);
+}
+
+void CommandBarView::OnFaviconFetched(const GURL& page_url,
+                                      const gfx::Image& favicon) {
+  if (closing_ || favicon.IsEmpty()) {
+    return;
+  }
+  for (size_t i = 0; i < items_.size(); ++i) {
+    Item& item = items_[i];
+    if (item.kind != Item::Kind::kAutocomplete ||
+        item.favicon_page_url != page_url) {
+      continue;
+    }
+    item.icon = ui::ImageModel::FromImage(favicon);
+    item.favicon_page_url = GURL();
+    if (i < rows_.size()) {
+      rows_[i]->SetIcon(item.icon);
+    }
+  }
+}
+
+void CommandBarView::OnActiveTabChanged(BrowserWindowInterface* browser) {
+  CloseBar();
+}
+
+void CommandBarView::OnTabWillDetach(tabs::TabInterface* tab,
+                                     tabs::TabInterface::DetachReason reason) {
+  CloseBar();
+}
+
+void CommandBarView::OnBrowserDidClose(BrowserWindowInterface* browser) {
+  CloseBar();
+  browser_close_subscription_ = {};
+}
+
+BEGIN_METADATA(CommandBarView)
+END_METADATA
