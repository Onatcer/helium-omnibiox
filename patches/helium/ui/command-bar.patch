+
+namespace helium {
+
+namespace {
+constexpr int kRowHeight = 36;
+constexpr int kRowCornerRadius = 8;
+constexpr int kIconSize = 16;
+constexpr gfx::Insets kRowInsets = gfx::Insets::VH(0, 10);
+}  // namespace
+
+CommandBarRowView::CommandBarRowView(PressedCallback on_pressed,
+                                     base::RepeatingClosure on_hovered)
+    : views::Button(std::move(on_pressed)), on_hovered_(std::move(on_hovered)) {
+  // Keyboard focus always stays in the command bar's text field.
+  SetFocusBehavior(FocusBehavior::NEVER);
+
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, kRowInsets,
+      /*between_child_spacing=*/10));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  layout->set_minimum_cross_axis_size(kRowHeight);
+
+  icon_ = AddChildView(std::make_unique<views::ImageView>());
+  icon_->SetImageSize(gfx::Size(kIconSize, kIconSize));
+  icon_->SetCanProcessEventsWithinSubtree(false);
+
+  title_ = AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_PRIMARY));
+  title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  title_->SetElideBehavior(gfx::ELIDE_TAIL);
+  title_->SetCanProcessEventsWithinSubtree(false);
+
+  subtitle_ = AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  subtitle_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  subtitle_->SetElideBehavior(gfx::ELIDE_TAIL);
+  subtitle_->SetCanProcessEventsWithinSubtree(false);
+
+  hint_ = AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  hint_->SetCanProcessEventsWithinSubtree(false);
+  hint_->SetVisible(false);
+
+  // Titles get most of the space; subtitles shrink first.
+  layout->SetFlexForView(title_, 3, /*use_min_size=*/true);
+  layout->SetFlexForView(subtitle_, 2, /*use_min_size=*/true);
+
+  UpdateColors();
+}
+
+CommandBarRowView::~CommandBarRowView() = default;
+
+void CommandBarRowView::SetContent(const ui::ImageModel& icon,
+                                   const std::u16string& title,
+                                   const std::u16string& subtitle,
+                                   const std::u16string& hint) {
+  SetIcon(icon);
+  title_->SetText(title);
+  subtitle_->SetText(subtitle);
+  subtitle_->SetVisible(!subtitle.empty());
+  hint_->SetText(hint);
+  hint_->SetVisible(selected_ && !hint.empty());
+  GetViewAccessibility().SetName(subtitle.empty() ? title
+                                                  : title + u", " + subtitle);
+}
+
+void CommandBarRowView::SetIcon(const ui::ImageModel& icon) {
+  icon_->SetImage(icon);
+}
+
+void CommandBarRowView::SetSelected(bool selected) {
+  if (selected_ == selected) {
+    return;
+  }
+  selected_ = selected;
+  hint_->SetVisible(selected_ && !hint_->GetText().empty());
+  UpdateColors();
+  if (selected_) {
+    NotifyAccessibilityEventDeprecated(ax::mojom::Event::kSelection, true);
+  }
+}
+
+void CommandBarRowView::OnMouseEntered(const ui::MouseEvent& event) {
+  views::Button::OnMouseEntered(event);
+  if (on_hovered_) {
+    on_hovered_.Run();
+  }
+}
+
+void CommandBarRowView::UpdateColors() {
+  if (selected_) {
+    SetBackground(views::CreateRoundedRectBackground(
+        kColorOmniboxResultsBackgroundSelected, kRowCornerRadius));
+    title_->SetEnabledColor(kColorOmniboxResultsTextSelected);
+    subtitle_->SetEnabledColor(kColorOmniboxResultsTextDimmedSelected);
+    hint_->SetEnabledColor(kColorOmniboxResultsTextDimmedSelected);
+  } else {
+    SetBackground(nullptr);
+    title_->SetEnabledColor(kColorOmniboxText);
+    subtitle_->SetEnabledColor(kColorOmniboxResultsTextDimmed);
+    hint_->SetEnabledColor(kColorOmniboxResultsTextDimmed);
+  }
+}
+
+BEGIN_METADATA(CommandBarRowView)
+END_METADATA
+
+}  // namespace helium
