+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMAND_BAR_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMAND_BAR_H_
+
+class BrowserWindowInterface;
+
+namespace helium {
+
+// Opens the floating command bar for `browser`, or closes it if it is already
+// open. Returns false when the command bar can't be used for this window
+// (feature disabled, non-tabbed window, window not visible, ...), in which
+// case the caller should fall back to its regular behavior.
+bool ToggleCommandBar(BrowserWindowInterface* browser);
+
+}  // namespace helium
