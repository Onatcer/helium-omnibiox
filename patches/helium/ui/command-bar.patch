index 00000000..ba3c55ef
--- /dev/null
+++ b/chrome/browser/ui/views/helium/command_bar/command_bar_local_results.cc
@@ -0,0 +1,220 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/command_bar/command_bar_local_results.h"
+
+#include <algorithm>
+
+#include "base/i18n/case_conversion.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace helium::command_bar {
+
+namespace {
+
+constexpr BrowserCommand kCommands[] = {
+    {IDC_NEW_WINDOW, IDS_HELIUM_COMMAND_BAR_CMD_NEW_WINDOW, u"window"},
+    {IDC_NEW_INCOGNITO_WINDOW, IDS_HELIUM_COMMAND_BAR_CMD_NEW_INCOGNITO_WINDOW,
+     u"private incognito window"},
+    {IDC_CLOSE_TAB, IDS_HELIUM_COMMAND_BAR_CMD_CLOSE_TAB, u"close tab"},
+    {IDC_RESTORE_TAB, IDS_HELIUM_COMMAND_BAR_CMD_REOPEN_TAB,
+     u"restore undo closed tab"},
+    {IDC_DUPLICATE_TAB, IDS_HELIUM_COMMAND_BAR_CMD_DUPLICATE_TAB,
+     u"duplicate clone copy tab"},
+    {IDC_WINDOW_PIN_TAB, IDS_HELIUM_COMMAND_BAR_CMD_PIN_TAB, u"pin unpin tab"},
+    {IDC_WINDOW_MUTE_SITE, IDS_HELIUM_COMMAND_BAR_CMD_MUTE_SITE,
+     u"mute unmute sound audio"},
+    {IDC_NEW_SPLIT_TAB, IDS_HELIUM_COMMAND_BAR_CMD_SPLIT_VIEW,
+     u"split view side by side"},
+    {IDC_COPY_URL, IDS_HELIUM_COMMAND_BAR_CMD_COPY_URL, u"copy url link"},
+    {IDC_BOOKMARK_THIS_TAB, IDS_HELIUM_COMMAND_BAR_CMD_BOOKMARK_TAB,
+     u"bookmark star save"},
+    {IDC_RELOAD, IDS_HELIUM_COMMAND_BAR_CMD_RELOAD, u"reload refresh"},
+    {IDC_FIND, IDS_HELIUM_COMMAND_BAR_CMD_FIND, u"find search page"},
+    {IDC_PRINT, IDS_HELIUM_COMMAND_BAR_CMD_PRINT, u"print pdf"},
+    {IDC_SHOW_HISTORY, IDS_HELIUM_COMMAND_BAR_CMD_HISTORY, u"history"},
+    {IDC_SHOW_DOWNLOADS, IDS_HELIUM_COMMAND_BAR_CMD_DOWNLOADS, u"downloads"},
+    {IDC_SHOW_BOOKMARK_MANAGER, IDS_HELIUM_COMMAND_BAR_CMD_BOOKMARKS,
+     u"bookmarks manager"},
+    {IDC_OPTIONS, IDS_HELIUM_COMMAND_BAR_CMD_SETTINGS,
+     u"settings preferences options"},
+    {IDC_MANAGE_EXTENSIONS, IDS_HELIUM_COMMAND_BAR_CMD_EXTENSIONS,
+     u"extensions addons plugins"},
+    {IDC_CLEAR_BROWSING_DATA, IDS_HELIUM_COMMAND_BAR_CMD_CLEAR_DATA,
+     u"clear delete history cache cookies"},
+    {IDC_DEV_TOOLS_TOGGLE, IDS_HELIUM_COMMAND_BAR_CMD_DEVTOOLS,
+     u"devtools inspect console developer"},
+    {IDC_TASK_MANAGER_MAIN_MENU, IDS_HELIUM_COMMAND_BAR_CMD_TASK_MANAGER,
+     u"task manager processes memory"},
+};
+
+bool IsWordBoundary(std::u16string_view text, size_t pos) {
+  if (pos == 0) {
+    return true;
+  }
+  constexpr std::u16string_view kSeparators = u" ./-_:?#&=@+,|()[]";
+  return kSeparators.find(text[pos - 1]) != std::u16string_view::npos;
+}
+
+int ScoreToken(std::u16string_view token, std::u16string_view text) {
+  if (text.starts_with(token)) {
+    return 3;
+  }
+  int best = 0;
+  for (size_t pos = text.find(token); pos != std::u16string_view::npos;
+       pos = text.find(token, pos + 1)) {
+    best = std::max(best, IsWordBoundary(text, pos) ? 2 : 1);
+    if (best == 2) {
+      break;
+    }
+  }
+  return best;
+}
+
+std::u16string LowerUrlForMatching(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::u16string();
+  }
+  std::string host = url.host();
+  if (host.starts_with("www.")) {
+    host = host.substr(4);
+  }
+  return base::i18n::ToLower(base::UTF8ToUTF16(host + url.path()));
+}
+
+}  // namespace
+
+base::span<const BrowserCommand> GetBrowserCommands() {
+  return kCommands;
+}
+
+int ScoreText(std::u16string_view query, std::u16string_view text) {
+  if (query.empty() || text.empty()) {
+    return 0;
+  }
+  const std::vector<std::u16string_view> tokens =
+      base::SplitStringPiece(query, base::kWhitespaceUTF16,
+                             base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (tokens.empty()) {
+    return 0;
+  }
+
+  int score = 0;
+  for (std::u16string_view token : tokens) {
+    const int token_score = ScoreToken(token, text);
+    if (token_score == 0) {
+      return 0;
+    }
+    score += token_score * static_cast<int>(token.size());
+  }
+  if (text == query) {
+    score += 10;
+  }
+  return score;
+}
+
+std::vector<CommandMatch> MatchCommands(BrowserWindowInterface* browser,
+                                        std::u16string_view query,
+                                        size_t max_results) {
+  std::vector<CommandMatch> matches;
+  if (query.empty()) {
+    return matches;
+  }
+
+  for (const BrowserCommand& command : kCommands) {
+    if (!chrome::IsCommandEnabled(browser, command.command_id)) {
+      continue;
+    }
+    const std::u16string label =
+        base::i18n::ToLower(l10n_util::GetStringUTF16(command.label_id));
+    // Labels are weighted above keywords, so "tab" ranks "Close tab" above
+    // commands that merely have "tab" as a keyword.
+    const int score = std::max(ScoreText(query, label) * 2,
+                               ScoreText(query, command.keywords));
+    if (score == 0) {
+      continue;
+    }
+    matches.push_back(
+        {&command, score, query.size() >= 3 && label.starts_with(query)});
+  }
+
+  std::stable_sort(matches.begin(), matches.end(),
+                   [](const CommandMatch& a, const CommandMatch& b) {
+                     return a.score > b.score;
+                   });
+  if (matches.size() > max_results) {
+    matches.resize(max_results);
+  }
+  return matches;
+}
+
+std::vector<TabMatch> MatchTabs(BrowserWindowInterface* browser,
+                                std::u16string_view query,
+                                size_t max_results) {
+  struct Candidate {
+    tabs::TabInterface* tab;
+    int score;
+    base::Time last_active;
+  };
+  std::vector<Candidate> candidates;
+
+  const tabs::TabInterface* current_tab = browser->GetActiveTabInterface();
+  for (BrowserWindowInterface* window : GetAllBrowserWindowInterfaces()) {
+    if (window->GetProfile() != browser->GetProfile() ||
+        window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        window->IsDeleteScheduled()) {
+      continue;
+    }
+    TabStripModel* model = window->GetTabStripModel();
+    if (!model) {
+      continue;
+    }
+    for (int i = 0; i < model->count(); ++i) {
+      tabs::TabInterface* tab = model->GetTabAtIndex(i);
+      if (!tab || tab == current_tab) {
+        continue;
+      }
+      int score = 1;
+      if (!query.empty()) {
+        score =
+            std::max(ScoreText(query, base::i18n::ToLower(tab->GetTitle())) * 2,
+                     ScoreText(query, LowerUrlForMatching(tab->GetURL())));
+        if (score == 0) {
+          continue;
+        }
+      }
+      candidates.push_back({tab, score, tab->GetLastActiveTime()});
+    }
+  }
+
+  std::sort(candidates.begin(), candidates.end(),
+            [](const Candidate& a, const Candidate& b) {
+              if (a.score != b.score) {
+                return a.score > b.score;
+              }
+              return a.last_active > b.last_active;
+            });
+
+  std::vector<TabMatch> matches;
+  for (const Candidate& candidate : candidates) {
+    if (matches.size() >= max_results) {
+      break;
+    }
+    matches.push_back({candidate.tab->GetWeakPtr(), candidate.score});
+  }
+  return matches;
+}
+
+}  // namespace helium::command_bar
