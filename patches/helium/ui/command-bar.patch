+#include "url/gurl.h"
+
+namespace helium {
+
+CommandBarOmniboxClient::CommandBarOmniboxClient(
+    BrowserWindowInterface* browser,
+    content::WebContents* active_contents)
+    : SearchboxOmniboxClient(browser->GetProfile(), active_contents),
+      browser_(browser),
+      favicon_cache_(FaviconServiceFactory::GetForProfile(
+                         browser->GetProfile(),
+                         ServiceAccessType::EXPLICIT_ACCESS),
+                     HistoryServiceFactory::GetForProfile(
+                         browser->GetProfile(),
+                         ServiceAccessType::EXPLICIT_ACCESS)) {}
+
+CommandBarOmniboxClient::~CommandBarOmniboxClient() = default;
+
+metrics::OmniboxEventProto::PageClassification
+CommandBarOmniboxClient::GetPageClassification(bool is_prefetch) const {
+  // The command bar always behaves as if the user focused the omnibox of a
+  // fresh new tab page, which is what Cmd/Ctrl+T used to open.
+  return metrics::OmniboxEventProto::INSTANT_NTP_WITH_OMNIBOX_AS_STARTING_FOCUS;
+}
+
+gfx::Image CommandBarOmniboxClient::GetFaviconForPageUrl(
+    const GURL& page_url,
+    FaviconFetchedCallback on_favicon_fetched) {
+  return favicon_cache_.GetFaviconForPageUrl(page_url,
+                                             std::move(on_favicon_fetched));
+}
+
+void CommandBarOmniboxClient::OnAutocompleteAccept(
+    const GURL& destination_url,
+    TemplateURLRef::PostContent* post_content,
+    WindowOpenDisposition disposition,
+    ui::PageTransition transition,
+    omnibox::AutocompleteMatchType match_type,
+    base::TimeTicks match_selection_timestamp,
+    bool destination_url_entered_without_scheme,
+    bool destination_url_entered_with_http_scheme,
+    const std::u16string& text,
+    const AutocompleteMatch& match,
+    const AutocompleteMatch& alternative_nav_match) {
+  std::string extra_headers;
+  for (const auto& header : match.extra_headers) {
+    base::StrAppend(&extra_headers,
+                    {header.first, ": ", header.second, "\r\n"});
+  }
+  OpenInBrowser(destination_url, disposition, transition, post_content,
+                std::move(extra_headers), match_selection_timestamp);
+}
+
+void CommandBarOmniboxClient::OpenUrl(GURL gurl,
+                                      WindowOpenDisposition disposition) {
+  OpenInBrowser(gurl, disposition, ui::PAGE_TRANSITION_GENERATED,
+                /*post_content=*/nullptr, /*extra_headers=*/std::string(),
+                base::TimeTicks::Now());
+}
+
+void CommandBarOmniboxClient::OpenInBrowser(
+    const GURL& url,
+    WindowOpenDisposition disposition,
+    ui::PageTransition transition,
+    TemplateURLRef::PostContent* post_content,
+    std::string extra_headers,
+    base::TimeTicks input_start) {
+  if (!url.is_valid() || !browser_) {
+    return;
+  }
+
+  NavigateParams params(browser_, url,
+                        ui::PageTransitionFromInt(
+                            transition | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR));
+  params.disposition = disposition;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  params.input_start = input_start;
+
+  // Like Cmd/Ctrl+T, keep new tabs in the group of the tab they were opened
+  // from.
+  if (disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB ||
+      disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB) {
+    TabStripModel* model = browser_->GetTabStripModel();
+    if (model && model->active_index() != TabStripModel::kNoTab) {
+      params.group = model->GetTabGroupForTab(model->active_index());
+    }
+  }
+
+  if (post_content && !post_content->second.empty()) {
+    params.post_data = network::ResourceRequestBody::CreateFromCopyOfBytes(
+        base::as_byte_span(post_content->second));
+    base::StrAppend(&extra_headers,
+                    {"Content-Type: ", post_content->first, "\r\n"});
+  }
+  params.extra_headers = std::move(extra_headers);
+
+  ::Navigate(&params);
+}
+
+}  // namespace helium
