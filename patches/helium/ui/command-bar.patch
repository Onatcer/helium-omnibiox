+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMAND_BAR_LOCAL_RESULTS_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMAND_BAR_LOCAL_RESULTS_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/weak_ptr.h"
+
+class BrowserWindowInterface;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace helium::command_bar {
+
+// A browser command that can be run from the command bar.
+struct BrowserCommand {
+  int command_id;
+  int label_id;
+  // Extra space separated, lowercase search terms (English only for now).
+  std::u16string_view keywords;
+};
+
+base::span<const BrowserCommand> GetBrowserCommands();
+
+// Returns how well `query` matches `text`. Both are expected to be lowercase.
+// Every whitespace separated token of `query` has to be found in `text`;
+// tokens matching at the start of `text` or of a word score higher than
+// tokens matching in the middle of a word. Returns 0 when there is no match.
+int ScoreText(std::u16string_view query, std::u16string_view text);
+
+struct CommandMatch {
+  const BrowserCommand* command;
+  int score;
+  // True when the label starts with the full query. Strong matches are shown
+  // above web results.
+  bool strong;
+};
+
+// Returns enabled commands matching `query` (lowercase), best first.
+std::vector<CommandMatch> MatchCommands(BrowserWindowInterface* browser,
+                                        std::u16string_view query,
+                                        size_t max_results);
+
+struct TabMatch {
+  base::WeakPtr<tabs::TabInterface> tab;
+  int score;
+};
+
+// Returns open tabs in normal windows of `browser`'s profile matching `query`
+// (lowercase), excluding `browser`'s active tab. An empty query returns the
+// most recently used tabs.
+std::vector<TabMatch> MatchTabs(BrowserWindowInterface* browser,
+                                std::u16string_view query,
+                                size_t max_results);
+
+}  // namespace helium::command_bar
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_COMMAND_BAR_COMMAND_BAR_LOCAL_RESULTS_H_
